
{
  "manifest_version": 3,
  "name": "Custom Cursor",
  "version": "1.0.0",
  "description": "Customize your browser cursor with cyberpunk styles.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/cursor.js"
      ],
      "run_at": "document_start"
    }
  ]
}
